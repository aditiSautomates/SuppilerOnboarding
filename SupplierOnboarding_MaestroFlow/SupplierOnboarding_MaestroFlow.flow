            "Body": "=js:((\"Hi,<br><br>\" +\n\"The supplier onboarding request has been reviewed and was not approved at this stage.<br><br>\" +\n\"<b>Supplier Details</b><br><br>\" +\n\"Supplier Name: \" + $vars.quickForm1.output.supplierName + \"<br>\" +\n\"Supplier Type: \" + $vars.quickForm1.output.supplierType + \"<br>\" +\n\"Annual Spend: ₹\" + $vars.quickForm1.output.annualSpend + \"<br>\" +\n\"Payment Terms: \" + $vars.quickForm1.output.paymentTerms + \"<br><br>\" +\n\"<b>Approval Status:</b> Rejected<br><br>\" +\n\"<b>Manager Comments:</b><br>\" +\n$vars.quickForm1.output.comments + \"<br><br>\" +\n\"<b>Next Steps:</b><br>\" +\n\"Please review the feedback provided and resubmit the request with the required information, if applicable.<br><br>\" +\n\"Regards,<br>\" +\n\"Procurement Operations\"))",
            "Importance": "normal"
          },
