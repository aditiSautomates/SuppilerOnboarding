            "Body": "=js:(\"Hi,<br><br>\" +\n\"Your supplier onboarding request has been <b>rejected</b>.<br><br>\" +\n\"<b>Supplier Details</b><br>\" +\n\"Supplier Name: \" + JSON.parse($vars.autonomousAgent1.output.content).supplierName + \"<br>\" +\n\"Supplier Type: \" + JSON.parse($vars.autonomousAgent1.output.content).supplierType + \"<br>\" +\n\"Annual Spend: ₹\" + JSON.parse($vars.autonomousAgent1.output.content).annualSpend + \"<br>\" +\n\"Payment Terms: \" + JSON.parse($vars.autonomousAgent1.output.content).paymentTerms + \"<br><br>\" +\n\"<b>Manager Comments</b><br>\" +\n\"Please review the manager decision and resubmit the request if required.<br><br>\" +\n\"Regards,<br>\" +\n\"Procurement Operations\")",
