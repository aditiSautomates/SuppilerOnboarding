    {
      "id": "decision2",
      "type": "core.logic.decision",
      "typeVersion": "1.3",
      "display": {
        "label": "Spend Threshold Check",
        "subLabel": "",
        "icon": "trending-up-down"
      },
      "inputs": {
        "trueLabel": "True",
        "falseLabel": "False",
        "expression": {
          "type": "jsExpression",
          "expression": "JSON.parse($vars.autonomousAgent1.output.content).estimatedAnnualSpend > 1000000",
          "fieldType": "boolean"
        }
      }
    },
    {
      "id": "quickForm1",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.1",
      "display": {
        "label": "Manager Approval",
