            "Subject": "Supplier Onboarding – Automatically Approved",
            "Body": "=js:(\"<html><body>\" +\n\"<p>Hi,</p>\" +\n\"<p>Your supplier onboarding request has been <b>automatically approved</b>.</p>\" +\n\"<p><b>Supplier Details:</b></p>\" +\n\"<p><b>Supplier Name:</b> \" + $vars.autonomousAgent1.output.content.supplierName + \"<br>\" +\n\"<b>Supplier Type:</b> \" + $vars.autonomousAgent1.output.content.supplierType + \"<br>\" +\n\"<b>Annual Spend:</b> ₹\" + $vars.autonomousAgent1.output.content.estimatedAnnualSpend + \"<br>\" +\n\"<b>Payment Terms:</b> \" + $vars.autonomousAgent1.output.content.paymentTerms + \"</p>\" +\n\"<p><b>Approval Status:</b> Automatically Approved</p>\" +\n\"<p>The request will now proceed for supplier onboarding.</p>\" +\n\"<p>Regards,<br>Procurement Operations</p>\" +\n\"</body></html>\")",
            "Importance": "normal"
          },
          "multipartParameters": [
            {
              "name": "body",
              "dataType": "string"
            },
            {
              "name": "file",
              "dataType": "file"
            }
          ],
