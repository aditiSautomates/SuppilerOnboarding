      "form": {
        "id": "settings-form",
        "title": "Agent settings",
        "metadata": {
          "propertyPanel": {
            "sectionTabs": {
              "section-advanced": "advanced"
            }
          }
        },
        "mode": "onChange",
        "reValidateMode": "onChange",
        "sections": [
          {
            "id": "section-1",
            "title": "Agent settings",
            "collapsible": true,
            "defaultExpanded": true,
            "fields": [
              {
                "name": "inputs.mode",
                "type": "custom",
                "component": "agent-harness-picker",
