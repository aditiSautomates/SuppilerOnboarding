      "model": {
        "type": "bpmn:ServiceTask",
        "serviceType": "Intsvc.UnifiedHttpRequest",
        "context": [
          {
            "name": "connectorKey",
            "type": "string",
            "value": "uipath-uipath-http"
          },
          {
            "name": "objectName",
            "type": "string",
            "value": "http-request"
          },
          {
            "name": "connection",
            "type": "string",
            "value": "<bindings.uipath-uipath-http connection>"
          },
          {
            "name": "folderKey",
            "type": "string",
            "value": "<bindings.FolderKey>"
          },
          {
            "name": "activityConfigurationVersion",
            "type": "string",
            "value": "v1"
          },
          {
            "name": "metadata",
            "body": {
              "telemetryData": {
                "connectorKey": "uipath-uipath-http",
                "connectorName": "HTTP Request"
              },
              "inputMetadata": {},
              "errorState": {
                "hasError": true
              }
            },
            "type": "json"
          }
        ],
        "expansion": {
          "processLevelVariables": [
            {
              "id": "{nodeId}.output",
              "name": "output",
              "type": "jsonSchema",
              "elementId": "{nodeId}",
              "custom": true
            },
            {
              "condition": "hasEdgeFromHandle('error')",
              "id": "{nodeId}.error",
              "name": "error",
              "type": "jsonSchema",
              "elementId": "{nodeId}",
              "custom": true
            }
          ],
          "nodes": [
            {
              "id": "{nodeId}",
              "type": "bpmn:SubProcess",
              "replaceOriginal": true,
              "data": {
                "label": "{node.data.label}",
                "isExpanded": true,
                "model": {
                  "serviceType": "BPMN.Variables",
                  "subprocessVariables": {
