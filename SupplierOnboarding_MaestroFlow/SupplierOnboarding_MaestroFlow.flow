ema.org/draft-07/schema#\",\"type\":\"object\",\"properties\":{\"Attachments[*]\":{\"title\":\"Attachments\",\"type\":\"array\",\"items\":{\"$ref\":\"#/definitions/Attachments[*]\"}},\"Categories[*]\":{\"title\":\"Categories\",\"type\":\"array\",\"items\":{\"$ref\":\"#/definitions/Categories[*]\"}},\"HasAttachments\":{\"title\":\"Has attachments\",\"type\":\"boolean\",\"description\":\"Indicates whether the email contains any attachments.\"},\"To[*]\":{\"title\":\"To\",\"type\":\"array\",\"items\":{\"$ref\":\"#/definitions/To[*]\"}},\"From\":{\"title\":\"From\",\"$ref\":\"#/definitions/From\"},\"Subject\":{\"title\":\"Email subject line\",\"type\":\"string\",\"description\":\"The subject line of the email message.\"},\"ParentFolders[*]\":{\"title\":\"Parent folders\",\"type\":\"array\",\"items\":{\"$ref\":\"#/definitions/ParentFolders[*]\"}},\"Importance\":{\"title\":\"Email importance level\",\"type\":\"string\",\"description\":\"Indicates the priority or significance of the email.\"},\"Type\":{\"title\":\"Email type\",\"type\":\"string\",\"description\":\"Specifies the category or format of the email.\"},\"ThreadID\":{\"title\":\"Email thread ID\",\"type\":\"string\",\"description\":\"A unique identifier for the email thread.\"},\"ID\":{\"title\":\"Email ID\",\"type\":\"string\",\"description\":\"The unique identifier for the email.\"},\"Body\":{\"title\":\"Email body\",\"type\":\"string\",\"description\":\"The main content of the email message.\"}},\"definitions\":{\"Attachments[*]\":{\"type\":\"object\",\"properties\":{\"MIMEType\":{\"title\":\"Attachment mime type\",\"type\":\"string\",\"description\":\"Specifies the MIME type of each attachment in the email.\"},\"ID\":{\"title\":\"Attachment identifier\",\"type\":\"string\",\"description\":\"Unique identifier for each attachment in the email.\"},\"Name\":{\"title\":\"Attachment file name\",\"type\":\"string\",\"description\":\"The name of the file attached to the email.\"},\"Size\":{\"title\":\"Attachment size\",\"type\":\"integer\",\"description\":\"The size of each attachment in the email.\"}}},\"Categories[*]\":{\"type\":\"object\",\"properties\":{\"ID\":{\"title\":\"Category ID\",\"type\":\"string\",\"description\":\"Identifies the category ID assigned to the email.\"},\"Name\":{\"title\":\"Email category name\",\"type\":\"string\",\"description\":\"The category assigned to the email for organization.\"}}},\"To[*]\":{\"type\":\"object\",\"properties\":{\"Email\":{\"title\":\"Recipient email address\",\"type\":\"string\",\"description\":\"Lists the email addresses of all recipients.\"},\"Name\":{\"title\":\"Recipient name\",\"type\":\"string\",\"description\":\"The name of the person or entity receiving the email.\"}}},\"From\":{\"type\":\"object\",\"properties\":{\"Email\":{\"title\":\"Sender's email address\",\"type\":\"string\",\"description\":\"Email address of the person who sent the message.\"},\"Name\":{\"title\":\"Sender's name\",\"type\":\"string\",\"description\":\"The name of the person or entity who sent the email.\"}}},\"ParentFolders[*]\":{\"type\":\"object\",\"properties\":{\"ID\":{\"title\":\"Parent folder identifier\",\"type\":\"string\",\"description\":\"Unique identifier for the parent folder containing the email.\"},\"Name\":{\"title\":\"Parent folder name\",\"type\":\"string\",\"description\":\"The name of the parent folder containing the email.\"}}}}},\"hasFileOutput\":false,\"populateOutputFields\":true,\"inputFields\":[{\"typeScriptDefinition\":null,\"useUrlInput\":false,\"id\":\"emailFolder\",\"name\":\"emailFolder\",\"displayName\":\"Email folder or label\",\"description\":\"The folder or label from where to get email messages\",\"type\":\"string\",\"sortOrder\":1,\"primaryKey\":false,\"lookup\":{\"objectName\":\"folder\",\"lookupNames\":[\"displayName\"],\"lookupValue\":\"referenceID\",\"path\":\"/folder\",\"childPath\":\"/folder?parentReference={name}\",\"hydration\":{\"url\":\"/folder/{id}\",\"method\":\"GETBYID\"}},\"design\":{\"component