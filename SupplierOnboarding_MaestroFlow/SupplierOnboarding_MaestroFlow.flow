    {
      "id": "sendEmail3",
      "type": "uipath.connector.uipath-google-gmail.send-email",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Supplier Onboarding Completed",
        "subLabel": "",
        "description": "Sends an email message",
        "sourceDisplayName": "Gmail",
        "icon": "https://cloud.uipath.com/b06e8321-6e72-4d10-a64f-4a41d5240ff4/studio_/typecache/icons/70091673b4573a26ec5090fa697c3bf61a0bedf4c77a302986b69d53bea30191.svg"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-google-gmail",
          "connectionId": "a163e374-aaac-4381-bd40-09041b7fb8d8",
          "connectionResourceId": "a163e374-aaac-4381-bd40-09041b7fb8d8",
          "connectionFolderKey": "07b2805c-c0a8-43c6-b20b-65ba9273e11f",
          "method": "POST",
          "endpoint": "/SendEmail",
          "queryParameters": {
            "SaveAsDraft": false
          },
          "bodyParameters": {
            "To": "=js:($vars.getNewestEmail1.output.To[0].Email)",
            "Subject": "Supplier Updated in System – ",
            "Body": "=js:((\"Hi,<br><br>\" +\n\"The supplier onboarding request has been successfully processed.<br><br>\" +\n\"<b>Supplier Details</b><br><br>\" +\n\"Supplier Name: \" + $vars.quickForm1.output.supplierName + \"<br>\" +\n\"Supplier Type: \" + $vars.quickForm1.output.supplierType + \"<br>\" +\n\"Annual Spend: ₹\" + $vars.quickForm1.output.annualSpend + \"<br>\" +\n\"Payment Terms: \" + $vars.quickForm1.output.paymentTerms + \"<br><br>\" +\n\"<b>Processing Status:</b> Completed<br>\" +\n\"<b>Enterprise System Status:</b> Successfully Updated<br><br>\" +\n\"The supplier record has been successfully created/updated in the downstream procurement system.<br><br>\" +\n\"No further action is required at this stage.<br><br>\" +\n\"Regards,<br>\" +\n\"Procurement Operations\"))",
            "Importance": "normal"
          },
          "multipartParameters": [
            {
              "name": "body",
              "dataType": "string"
            },
            {
              "name": "file",
              "dataType": "file"
            }
          ],
