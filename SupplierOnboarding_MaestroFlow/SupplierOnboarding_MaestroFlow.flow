      },
      "inputs": {
        "detail": {
          "connector": "uipath-google-gmail",
          "connectionId": "a163e374-aaac-4381-bd40-09041b7fb8d8",
          "connectionResourceId": "a163e374-aaac-4381-bd40-09041b7fb8d8",
          "connectionFolderKey": "07b2805c-c0a8-43c6-b20b-65ba9273e11f",
          "method": "POST",
          "endpoint": "/SendEmail",
          "queryParameters": {
            "SaveAsDraft": false
          },
          "bodyParameters": {
            "To": "aditismwl@gmail.com",
            "Subject": "=js:([ \"Supplier Request Approved – \", JSON.parse($vars.autonomousAgent1.output.content).supplierName ].join(''))",
            "Body": "=js:(`<html>\n<body>\n<p>Hi,</p>\n\n<p>Your supplier onboarding request has been <b>approved</b>.</p>\n\n<p><b>Supplier Details</b></p>\n\n<table>\n  <tr>\n    <td><b>Supplier Name:</b></td>\n    <td>${JSON.parse($vars.autonomousAgent1.output.content).supplierName}</td>\n  </tr>\n  <tr>\n    <td><b>Supplier Type:</b></td>\n    <td>${JSON.parse($vars.autonomousAgent1.output.content).supplierType}</td>\n  </tr>\n  <tr>\n    <td><b>Annual Spend:</b></td>\n    <td>₹${JSON.parse($vars.autonomousAgent1.output.content).estimatedAnnualSpend}</td>\n  </tr>\n  <tr>\n    <td><b>Payment Terms:</b></td>\n    <td>${JSON.parse($vars.autonomousAgent1.output.content).paymentTerms}</td>\n  </tr>\n</table>\n\n<p><b>Manager Comments:</b><br>\n${$vars.quickForm1.output?.comments || \"\"}\n</p>\n\n<p>The request can now proceed to the next stage.</p>\n\n<p>Regards,<br>\nProcurement Team</p>\n\n</body>\n</html>`)",
            "Importance": "normal"
          },
